{
  "name": "@meddevkit/adapter-azure",
  "version": "0.1.0",
  "description": "Azure AI Language Text Analytics for health adapter for MedDevKit (fetch-only, no Azure SDK)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "medical",
    "healthcare",
    "clinical-notes",
    "nlp",
    "azure",
    "text-analytics-for-health",
    "ontology",
    "icd-10",
    "snomed",
    "rxnorm",
    "meddevkit"
  ],
  "author": "Lyndon Hughey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MedDevKit/meddevkit.git",
    "directory": "packages/adapter-azure"
  },
  "homepage": "https://meddevkit.github.io/meddevkit/",
  "bugs": {
    "url": "https://github.com/meddevkit/meddevkit/issues"
  },
  "peerDependencies": {
    "@meddevkit/chunker": "^0.3.0"
  },
  "devDependencies": {
    "@meddevkit/chunker": "workspace:^",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
